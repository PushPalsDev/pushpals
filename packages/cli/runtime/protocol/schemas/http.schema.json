{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PushPals core session HTTP and transport contracts",
  "definitions": {
    "ClientRegistration": {
      "type": "object",
      "required": ["clientId", "kind"],
      "properties": {
        "clientId": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "repoRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CreateSessionRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,64}$"
        },
        "client": { "$ref": "#/definitions/ClientRegistration" }
      },
      "additionalProperties": false
    },
    "CreateSessionResponse": {
      "type": "object",
      "required": ["sessionId", "protocolVersion"],
      "properties": {
        "sessionId": { "type": "string" },
        "protocolVersion": { "type": "string", "const": "0.1.0" }
      },
      "additionalProperties": false
    },
    "MessageRequest": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "intent": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "MessageResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "code": {
          "type": "string",
          "enum": ["accepted", "invalid", "session_not_found", "enqueue_failed"]
        },
        "eventId": { "type": "string" },
        "requestId": { "type": "string" },
        "queuePosition": { "type": "number", "minimum": 0 },
        "etaMs": { "type": "number", "minimum": 0 },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CommandRequest": {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": { "$ref": "envelope.schema.json#/properties/type" },
        "payload": { "type": "object", "additionalProperties": true },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "correlationId": { "type": "string" },
        "turnId": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CommandResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "eventId": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ApprovalDecisionRequest": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["approve", "deny"]
        }
      },
      "additionalProperties": false
    },
    "ApprovalDecisionResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SessionEventFrame": {
      "type": "object",
      "required": ["envelope", "cursor"],
      "properties": {
        "envelope": { "$ref": "envelope.schema.json" },
        "cursor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
